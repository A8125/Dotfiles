layout {

    focus-ring {
        active-color   "#a5c9fe"
        inactive-color "#111318"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a5c9fe"
        inactive-color "#111318"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#a5c9fe"
        inactive-color "#204876"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a5c9fe80"
    }
}

recent-windows {
    highlight {
        active-color "#a5c9fe"
        urgent-color "#ffb4ab"
    }
}
