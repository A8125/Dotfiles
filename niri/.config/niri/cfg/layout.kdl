// =============================================================================
// Niri Layout Configuration
// =============================================================================
// Settings for the scrolling-tiling window layout, window gaps, and preset widths.
// Documentation: https://github.com/YaLTeR/niri/wiki/Configuration:-Layout

layout {
    gaps 16 // Gap between windows (in physical pixels)
    center-focused-column "never" // Don't auto-center focused column

    background-color "transparent" // Needed for noctalia-shell to draw wallpaper behind windows

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    struts {}
}
