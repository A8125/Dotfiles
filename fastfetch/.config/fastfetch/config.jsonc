{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/pngs/fmab_red.png",
    "type": "kitty",
    "height": 15,
    "padding": {
      "top": 1,
      "left": 1,
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom",
    },
    {
      "key": "│ {#31}user      {#keys}│",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "│ {#32}display   {#keys}│",
      "type": "display",
      "compactType": "original-with-refresh-rate",
    },
    {
      "key": "│ {#33}uptime    {#keys}│",
      "type": "uptime",
    },
    {
      "key": "│ {#35}kernel    {#keys}│",
      "type": "kernel",
    },
    {
      "key": "│ {#36}desktop   {#keys}│",
      "type": "de",
    },
    {
      "key": "│ {#32}shell     {#keys}│",
      "type": "shell",
    },
    {
      "key": "│ {#31}gpu       {#keys}│",
      "type": "gpu",
      "format": "{2}",
    },
    {
      "key": "│ {#34}disk      {#keys}│",
      "type": "disk",
      "folders": "/",
    },
    {
      "key": "│ {#35}memory    {#keys}│",
      "type": "memory",
    },
    {
      "key": "├───────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#39}colors    {#keys}│",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "╰───────────╯",
      "type": "custom",
    },
  ],
}
