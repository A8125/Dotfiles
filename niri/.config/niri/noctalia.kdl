layout {

    focus-ring {
        active-color   "#84d2e6"
        inactive-color "#0f1416"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#84d2e6"
        inactive-color "#0f1416"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#84d2e6"
        inactive-color "#004e5c"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#84d2e680"
    }
}

recent-windows {
    highlight {
        active-color "#84d2e6"
        urgent-color "#ffb4ab"
    }
}
